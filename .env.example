# Frontier LLM used to learn and repair recipes: anthropic | openai
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Jev (TypeSafe) for cheap typed judgments
TYPESAFE_API_KEY=
# ElevenLabs spoken morning briefing (optional)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional
WATCHTOWER_LAB=0
WATCHTOWER_DATA=/data
READ_INTERVAL_SECONDS=600
